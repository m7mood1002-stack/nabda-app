# انسخ الملف ده باسم .env.local واملأ القيم الحقيقية بتاعتك

# بيانات حساب Authorize.Net (من لوحة تحكم الحساب: Account > Settings > API Credentials & Keys)
AUTHORIZE_API_LOGIN_ID=your_api_login_id
AUTHORIZE_TRANSACTION_KEY=your_transaction_key

# sandbox أثناء التطوير والاختبار، وproduction لما تشتغل فعليًا بفلوس حقيقية
AUTHORIZE_ENVIRONMENT=sandbox

# الـ Client Key العام (Public Client Key) بتاع Accept.js - آمن يظهر في الواجهة الأمامية
NEXT_PUBLIC_AUTHORIZE_CLIENT_KEY=your_public_client_key
NEXT_PUBLIC_AUTHORIZE_API_LOGIN_ID=your_api_login_id

# مفتاح تشفير الجلسات (JWT) - غيّره لأي نص عشوائي طويل
JWT_SECRET=change_this_to_a_long_random_string
